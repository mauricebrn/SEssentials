# ============================================================
#  NEWS-SYSTEM  (für das Plugin "Skript", getestet ab 2.8)
#
#  Spieler:
#    /news              -> News-Übersicht (Kurzversion, klickbar)
#    /news read <id>    -> Vollständige Nachricht
#
#  Admins (Permission: news.admin):
#    /newsadmin         -> Admin-Panel (GUI)
#    /newsadmin edit <id>
#
#  Formatierung im Inhalt:
#    &a, &l ...            -> Farbcodes
#    [Text](/befehl)       -> klickbarer Befehl
#    \n                    -> Zeilenumbruch
# ============================================================

options:
    perm: news.admin
    prefix: &6&lNews &8»
    joindelay: 3 seconds
    line: &8&m                                                   

# ------------------------------------------------------------
#  Hilfsfunktionen
# ------------------------------------------------------------

function news_status(id: number) :: text:
    if {news::%{_id}%::title} is not set:
        return "none"
    if {news::%{_id}%::visible} is true:
        if {news::%{_id}%::start} is set:
            if {news::%{_id}%::start} > now:
                return "geplant"
        if {news::%{_id}%::expires} is set:
            if {news::%{_id}%::expires} <= now:
                return "abgelaufen"
        return "aktiv"
    return "entwurf"

function news_status_label(s: text) :: text:
    if {_s} is "aktiv":
        return "&aAktiv"
    else if {_s} is "geplant":
        return "&bGeplant"
    else if {_s} is "abgelaufen":
        return "&6Abgelaufen"
    return "&7Entwurf"

function news_prio(p: number) :: text:
    if {_p} >= 4:
        return "&4&lDRINGEND"
    else if {_p} = 3:
        return "&cWichtig"
    else if {_p} = 2:
        return "&eNormal"
    return "&7Info"

function news_date(d: date) :: text:
    return {_d} formatted as "dd.MM.yyyy HH:mm"

# Sucht das letzte Vorkommen eines Zeichens (1-basiert, 0 = nicht gefunden).
# Ersetzt "last index of", das in manchen Skript-Versionen um 1 daneben liegt.
function news_last_index(needle: text, t: text) :: number:
    set {_i} to length of {_t}
    while {_i} >= 1:
        if subtext of {_t} from characters {_i} to {_i} is {_needle}:
            return {_i}
        remove 1 from {_i}
    return 0

# Wandelt [Text](/befehl) in klickbare Links um.
# links = false -> nur der Text wird angezeigt (für Kurzversionen)
function news_render(t: text, links: boolean) :: text:
    set {_out} to ""
    set {_r} to {_t}
    loop 50 times:
        if {_r} does not contain "](/":
            exit loop
        set {_mid} to index of "](/" in {_r}
        if {_mid} <= 1:
            exit loop
        set {_head} to first ({_mid} - 1) characters of {_r}
        set {_open} to news_last_index("[", {_head})
        if {_open} < 1:
            exit loop
        set {_after} to subtext of {_r} from characters ({_mid} + 2) to (length of {_r})
        set {_close} to index of ")" in {_after}
        if {_close} < 2:
            exit loop
        set {_cmd} to first ({_close} - 1) characters of {_after}
        if {_open} < length of {_head}:
            set {_label} to subtext of {_head} from characters ({_open} + 1) to (length of {_head})
        else:
            set {_label} to {_cmd}
        set {_before} to ""
        if {_open} > 1:
            set {_before} to first ({_open} - 1) characters of {_head}
        if {_links} is true:
            set {_out} to "%{_out}%%{_before}%<cmd:%{_cmd}%><ttp:Klicken zum Ausführen: %{_cmd}%>&b&n%{_label}%<reset>"
        else:
            set {_out} to "%{_out}%%{_before}%&b%{_label}%&7"
        if {_close} < length of {_after}:
            set {_r} to subtext of {_after} from characters ({_close} + 1) to (length of {_after})
        else:
            set {_r} to ""
    return "%{_out}%%{_r}%"

function news_short(id: number, max: number) :: text:
    set {_s} to news_render({news::%{_id}%::content}, false)
    set {_s} to uncolored {_s}
    replace all "\n" with " " in {_s}
    if length of {_s} > {_max}:
        set {_s} to "%first ({_max} - 3) characters of {_s}%..."
    return {_s}

function news_item(type: itemtype, name: text, lore: texts) :: item:
    set {_i} to {_type} named (colored {_name})
    set {_c::*} to colored {_lore::*}
    set {_i} to {_i} with lore {_c::*}
    return {_i}

# ------------------------------------------------------------
#  Spieler-Ansicht
# ------------------------------------------------------------

function news_feed(p: player, silent: boolean = false):
    set {_count} to 0
    set {_prio} to 4
    while {_prio} >= 1:
        loop reversed {news.list::*}:
            set {_id} to loop-value
            if {news::%{_id}%::prio} = {_prio}:
                if news_status({_id}) is "aktiv":
                    add 1 to {_count}
                    set {_ids::%{_count}%} to {_id}
        remove 1 from {_prio}
    if {_count} = 0:
        if {_silent} is false:
            send formatted "{@prefix} &7Aktuell gibt es keine News." to {_p}
        stop
    send formatted "{@line}" to {_p}
    send formatted " &6&l✉ NEWS &8» &7%{_count}% Meldung(en) &8- &7Klicke zum Lesen" to {_p}
    send "" to {_p}
    loop {_ids::*}:
        set {_id} to loop-value
        set {_short} to news_short({_id}, 45)
        set {_prio} to news_prio({news::%{_id}%::prio})
        set {_title} to {news::%{_id}%::title}
        set {_new} to ""
        if {news.seen::%uuid of {_p}%::%{_id}%} is not set:
            set {_new} to "&a&lNEU "
        set {_line} to " <cmd:/news read %{_id}%><ttp:Klicke, um die ganze Nachricht zu lesen>%{_new}%&8[%{_prio}%&8] &f&l%{_title}% &8» &7%{_short}%<reset>"
        send formatted {_line} to {_p}
    send formatted "{@line}" to {_p}

function news_show(p: player, id: number, mark: boolean = true):
    set {_title} to {news::%{_id}%::title}
    set {_prio} to news_prio({news::%{_id}%::prio})
    if {news::%{_id}%::start} is set:
        set {_date} to news_date({news::%{_id}%::start})
    else:
        set {_date} to news_date({news::%{_id}%::created})
    set {_c} to news_render({news::%{_id}%::content}, true)
    set {_lines::*} to {_c} split at "\n"
    send formatted "{@line}" to {_p}
    send formatted " %{_prio}% &8| &f&l%{_title}%" to {_p}
    send formatted " &7Veröffentlicht am &f%{_date}%" to {_p}
    send "" to {_p}
    loop {_lines::*}:
        set {_l} to " &f%loop-value%"
        send formatted {_l} to {_p}
    send "" to {_p}
    send formatted " <cmd:/news><ttp:Zurück zur Übersicht>&8[&7« Alle News&8]<reset>" to {_p}
    send formatted "{@line}" to {_p}
    if {_mark} is true:
        set {news.seen::%uuid of {_p}%::%{_id}%} to true

on join:
    wait {@joindelay}
    player is online
    news_feed(player, true)

command /news [<text>] [<integer>]:
    aliases: /neuigkeiten
    executable by: players
    trigger:
        if arg-1 is "read" or "lesen":
            if arg-2 is not set:
                send formatted "{@prefix} &cBenutze: /news read <id>"
                stop
            set {_s} to news_status(arg-2)
            if {_s} is not "aktiv":
                if player does not have permission "{@perm}":
                    send formatted "{@prefix} &cDiese News ist nicht verfügbar."
                    stop
                if {_s} is "none":
                    send formatted "{@prefix} &cDiese News existiert nicht."
                    stop
            news_show(player, arg-2, true)
            stop
        news_feed(player, false)

# ------------------------------------------------------------
#  Admin-Panel
# ------------------------------------------------------------

function news_create() :: number:
    add 1 to {news.nextid}
    set {_id} to {news.nextid}
    set {news::%{_id}%::title} to "Neue News"
    set {news::%{_id}%::content} to "Hier steht der Inhalt. [Alle News](/news)"
    set {news::%{_id}%::prio} to 2
    set {news::%{_id}%::created} to now
    set {news::%{_id}%::visible} to false
    set {news.list::%{_id}%} to {_id}
    return {_id}

function news_toggle(id: number):
    if {news::%{_id}%::visible} is true:
        set {news::%{_id}%::visible} to false
    else:
        set {news::%{_id}%::visible} to true

function news_panel(p: player):
    set {_u} to uuid of {_p}
    set {_gui} to chest inventory with 6 rows named "&8News-Verwaltung"
    delete {-news.slots::%{_u}%::*}
    set {_slot} to 0
    loop reversed {news.list::*}:
        if {_slot} >= 45:
            exit loop
        set {_id} to loop-value
        set {_s} to news_status({_id})
        set {_mat} to paper
        if {_s} is "entwurf":
            set {_mat} to gray dye
        else if {_s} is "geplant":
            set {_mat} to light blue dye
        else if {_s} is "abgelaufen":
            set {_mat} to orange dye
        set {_st} to news_status_label({_s})
        set {_pr} to news_prio({news::%{_id}%::prio})
        set {_cr} to news_date({news::%{_id}%::created})
        set {_start} to "&fsofort"
        if {news::%{_id}%::start} is set:
            set {_start} to "&f%news_date({news::%{_id}%::start})%"
        set {_end} to "&aunbegrenzt"
        if {news::%{_id}%::expires} is set:
            set {_end} to "&f%news_date({news::%{_id}%::expires})%"
        set {_short} to news_short({_id}, 35)
        delete {_lore::*}
        set {_lore::*} to "&7Status: %{_st}%", "&7Priorität: %{_pr}%", "&7Erstellt: &f%{_cr}%", "&7Start: %{_start}%", "&7Ende: %{_end}%", "", "&8%{_short}%", "", "&eLinksklick &7» Bearbeiten", "&eRechtsklick &7» Sichtbarkeit umschalten"
        set slot {_slot} of {_gui} to news_item({_mat}, "&f&l%{news::%{_id}%::title}% &8(Nr. %{_id}%)", {_lore::*})
        set {-news.slots::%{_u}%::%{_slot}%} to {_id}
        add 1 to {_slot}
    set {_l::*} to "&7Zeigt den Feed so,", "&7wie Spieler ihn sehen."
    set slot 45 of {_gui} to news_item(spyglass, "&e&lFeed-Vorschau", {_l::*})
    set {_l::*} to "&7Erstellt einen neuen Entwurf."
    set slot 49 of {_gui} to news_item(emerald, "&a&l+ Neue News", {_l::*})
    set {_l::*} to "&7Panel schließen."
    set slot 53 of {_gui} to news_item(barrier, "&c&lSchließen", {_l::*})
    open {_gui} to {_p}
    set {-news.gui::%{_u}%} to "panel"

function news_editor(p: player, id: number):
    set {_u} to uuid of {_p}
    set {_gui} to chest inventory with 3 rows named "&8News Nr. %{_id}% bearbeiten"
    set {_title} to {news::%{_id}%::title}
    set {_short} to news_short({_id}, 35)
    set {_pr} to news_prio({news::%{_id}%::prio})
    set {_st} to news_status_label(news_status({_id}))

    set {_l::*} to "&7Aktuell: &f%{_title}%", "", "&eKlick &7» Neuen Titel eingeben"
    set slot 10 of {_gui} to news_item(name tag, "&e&lTitel", {_l::*})

    set {_l::*} to "&7Aktuell: &8%{_short}%", "", "&7Link: &f[Text](/befehl)", "&7Umbruch: &f\n", "&7Farben: &f&&a, &&l ...", "", "&eKlick &7» Neuen Inhalt eingeben"
    set slot 11 of {_gui} to news_item(writable book, "&e&lInhalt ersetzen", {_l::*})

    set {_l::*} to "&7Hängt Text an den Inhalt an.", "&7(für lange Texte über 256 Zeichen)", "", "&eKlick &7» Text anhängen"
    set slot 12 of {_gui} to news_item(feather, "&e&lInhalt ergänzen", {_l::*})

    set {_l::*} to "&7Aktuell: %{_pr}%", "", "&eLinksklick &7» erhöhen", "&eRechtsklick &7» senken"
    set slot 13 of {_gui} to news_item(nether star, "&e&lPriorität", {_l::*})

    set {_start} to "&fsofort"
    if {news::%{_id}%::start} is set:
        set {_start} to "&f%news_date({news::%{_id}%::start})%"
    set {_l::*} to "&7Aktuell: %{_start}%", "", "&eLinksklick &7» Startzeit setzen", "&eRechtsklick &7» sofort"
    set slot 14 of {_gui} to news_item(compass, "&e&lStartzeit", {_l::*})

    set {_end} to "&aunbegrenzt"
    if {news::%{_id}%::expires} is set:
        set {_end} to "&f%news_date({news::%{_id}%::expires})%"
    set {_l::*} to "&7Läuft ab: %{_end}%", "", "&eLinksklick &7» Laufzeit setzen", "&eRechtsklick &7» unbegrenzt"
    set slot 15 of {_gui} to news_item(clock, "&e&lLaufzeit", {_l::*})

    set {_l::*} to "&7Status: %{_st}%", "", "&eKlick &7» Veröffentlichen / Entwurf"
    if {news::%{_id}%::visible} is true:
        set slot 16 of {_gui} to news_item(lime dye, "&a&lVeröffentlicht", {_l::*})
    else:
        set slot 16 of {_gui} to news_item(gray dye, "&7&lEntwurf", {_l::*})

    set {_l::*} to "&7Zeigt die vollständige", "&7Nachricht im Chat."
    set slot 22 of {_gui} to news_item(spyglass, "&b&lVorschau", {_l::*})

    set {_l::*} to "&7Zurück zur Übersicht."
    set slot 18 of {_gui} to news_item(arrow, "&7&l« Zurück", {_l::*})

    set {_l::*} to "&7Löscht diese News endgültig.", "", "&cShift + Klick &7» Löschen"
    set slot 26 of {_gui} to news_item(tnt, "&c&lLöschen", {_l::*})

    open {_gui} to {_p}
    set {-news.gui::%{_u}%} to "editor"
    set {-news.edit::%{_u}%} to {_id}

function news_prompt(p: player, mode: text, id: number, what: text):
    set {-news.input::%uuid of {_p}%} to {_mode}
    set {-news.edit::%uuid of {_p}%} to {_id}
    close {_p}'s inventory
    send "" to {_p}
    send formatted "{@prefix} &7Gib %{_what}% im Chat ein:" to {_p}
    if {_mode} is "content" or "append":
        send formatted " &8- &7Klickbarer Befehl: &f[Alle News](/news)" to {_p}
        send formatted " &8- &7Zeilenumbruch: &f\n &8| &7Farben: &f&&a &&l ..." to {_p}
    if {_mode} is "start" or "end":
        send formatted " &8- &7Zeitspanne auf Englisch, z. B. &f2 hours&7, &f7 days&7, &f30 minutes" to {_p}
    send formatted " <cmd:/newsadmin cancel><ttp:Eingabe abbrechen>&c[Abbrechen]<reset> &8(oder &7abbrechen &8schreiben)" to {_p}

command /newsadmin [<text>] [<integer>]:
    permission: {@perm}
    permission message: &cDazu hast du keine Rechte.
    executable by: players
    trigger:
        set {_u} to uuid of player
        if arg-1 is "cancel":
            if {-news.input::%{_u}%} is set:
                delete {-news.input::%{_u}%}
                send formatted "{@prefix} &7Eingabe abgebrochen."
                if news_status({-news.edit::%{_u}%}) is not "none":
                    news_editor(player, {-news.edit::%{_u}%})
            stop
        if arg-1 is "edit":
            if news_status(arg-2) is "none":
                send formatted "{@prefix} &cDiese News existiert nicht."
                stop
            news_editor(player, arg-2)
            stop
        news_panel(player)

# ------------------------------------------------------------
#  GUI-Klicks
# ------------------------------------------------------------

on inventory click:
    set {_u} to uuid of player
    {-news.gui::%{_u}%} is set
    cancel event
    event-inventory is not player's inventory
    if player does not have permission "{@perm}":
        close player's inventory
        stop
    set {_gui} to {-news.gui::%{_u}%}
    set {_slot} to index of event-slot
    set {_right} to false
    set {_shift} to false
    if click type is right mouse button or right mouse button with shift:
        set {_right} to true
    if click type is left mouse button with shift or right mouse button with shift:
        set {_shift} to true
    wait 1 tick

    # --- Übersicht ---
    if {_gui} is "panel":
        if {_slot} < 45:
            set {_id} to {-news.slots::%{_u}%::%{_slot}%}
            {_id} is set
            if {_right} is true:
                news_toggle({_id})
                news_panel(player)
            else:
                news_editor(player, {_id})
        else if {_slot} = 45:
            close player's inventory
            news_feed(player, false)
        else if {_slot} = 49:
            set {_id} to news_create()
            news_editor(player, {_id})
        else if {_slot} = 53:
            close player's inventory
        stop

    # --- Editor ---
    set {_id} to {-news.edit::%{_u}%}
    if news_status({_id}) is "none":
        close player's inventory
        stop
    if {_slot} = 10:
        news_prompt(player, "title", {_id}, "den neuen &fTitel")
    else if {_slot} = 11:
        news_prompt(player, "content", {_id}, "den neuen &fInhalt")
    else if {_slot} = 12:
        news_prompt(player, "append", {_id}, "den &fanzuhängenden Text")
    else if {_slot} = 13:
        if {_right} is true:
            if {news::%{_id}%::prio} > 1:
                remove 1 from {news::%{_id}%::prio}
        else:
            if {news::%{_id}%::prio} < 4:
                add 1 to {news::%{_id}%::prio}
        news_editor(player, {_id})
    else if {_slot} = 14:
        if {_right} is true:
            delete {news::%{_id}%::start}
            news_editor(player, {_id})
        else:
            news_prompt(player, "start", {_id}, "in wie viel Zeit die News &fstarten &7soll")
    else if {_slot} = 15:
        if {_right} is true:
            delete {news::%{_id}%::expires}
            news_editor(player, {_id})
        else:
            news_prompt(player, "end", {_id}, "die &fLaufzeit &7(ab Start)")
    else if {_slot} = 16:
        news_toggle({_id})
        news_editor(player, {_id})
    else if {_slot} = 22:
        close player's inventory
        news_show(player, {_id}, false)
        send formatted " <cmd:/newsadmin edit %{_id}%><ttp:Zurück zum Editor>&8[&e« Zurück zum Editor&8]<reset>"
    else if {_slot} = 18:
        news_panel(player)
    else if {_slot} = 26:
        if {_shift} is true:
            delete {news::%{_id}%::*}
            delete {news.list::%{_id}%}
            send formatted "{@prefix} &cNews Nr. %{_id}% wurde gelöscht."
            news_panel(player)
        else:
            send formatted "{@prefix} &7Zum Löschen &cShift + Klick &7benutzen."

on inventory close:
    delete {-news.gui::%uuid of player%}

on quit:
    delete {-news.gui::%uuid of player%}
    delete {-news.input::%uuid of player%}
    delete {-news.edit::%uuid of player%}

# ------------------------------------------------------------
#  Chat-Eingabe
# ------------------------------------------------------------

on chat with priority lowest:
    set {_u} to uuid of player
    {-news.input::%{_u}%} is set
    cancel event
    set {_mode} to {-news.input::%{_u}%}
    set {_id} to {-news.edit::%{_u}%}
    set {_m} to message
    delete {-news.input::%{_u}%}
    wait 1 tick
    player is online
    if news_status({_id}) is "none":
        send formatted "{@prefix} &cDiese News existiert nicht mehr."
        stop
    if {_m} is "abbrechen":
        send formatted "{@prefix} &7Eingabe abgebrochen."
        news_editor(player, {_id})
        stop

    if {_mode} is "title":
        set {news::%{_id}%::title} to {_m}
    else if {_mode} is "content":
        set {news::%{_id}%::content} to {_m}
    else if {_mode} is "append":
        set {news::%{_id}%::content} to "%{news::%{_id}%::content}% %{_m}%"
    else if {_mode} is "start":
        if {_m} is "jetzt" or "sofort":
            delete {news::%{_id}%::start}
        else:
            set {_ts} to {_m} parsed as timespan
            if {_ts} is not set:
                send formatted "{@prefix} &cUngültige Zeitspanne. Beispiel: &f2 hours&c. Versuch es nochmal:"
                set {-news.input::%{_u}%} to "start"
                stop
            set {news::%{_id}%::start} to {_ts} after now
    else if {_mode} is "end":
        if {_m} is "unbegrenzt" or "permanent":
            delete {news::%{_id}%::expires}
        else:
            set {_ts} to {_m} parsed as timespan
            if {_ts} is not set:
                send formatted "{@prefix} &cUngültige Zeitspanne. Beispiel: &f7 days&c. Versuch es nochmal:"
                set {-news.input::%{_u}%} to "end"
                stop
            set {_base} to now
            if {news::%{_id}%::start} is set:
                if {news::%{_id}%::start} > now:
                    set {_base} to {news::%{_id}%::start}
            set {news::%{_id}%::expires} to {_ts} after {_base}

    send formatted "{@prefix} &aGespeichert."
    news_editor(player, {_id})
