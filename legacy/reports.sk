# =====================================================================
#   REPORT SYSTEM - Skript (für Paper/Spigot mit dem Skript-Plugin)
# =====================================================================
#
#   Benötigt: Skript 2.6+ (https://hangar.papermc.io/SkriptLang/Skript)
#   Keine Addons nötig - läuft mit reinem Skript.
#
#   INSTALLATION:
#   1. Diese Datei nach /plugins/Skript/scripts/reports.sk kopieren
#   2. Im Spiel/Konsole: /sk reload reports   (oder /sk reload all)
#
#   PERMISSIONS:
#   - reports.use            -> darf /report benutzen (Standard: alle)
#   - reports.notify         -> bekommt Live-Benachrichtigung bei neuen Reports
#   - reports.admin          -> darf /reports (Admin-GUI) öffnen
#   - reports.bypasscooldown -> ignoriert das 30s-Cooldown von /report
#
#   DATENSTRUKTUR (Skript-Variablen, werden automatisch gespeichert):
#   {reports::%id%::reporter}   -> Name des Melders
#   {reports::%id%::reported}   -> Name des gemeldeten Spielers
#   {reports::%id%::reason}     -> Grund
#   {reports::%id%::time}       -> Zeitpunkt der Meldung
#   {reports::%id%::status}     -> "open" oder "resolved"
#   {reports::open::*}          -> Liste aller offenen Report-IDs
#
#   GUI-STATUS (temporäre Variablen, werden NICHT gespeichert):
#   {-gui::type::%uuid%}        -> "list" oder "detail" solange ein Report-GUI offen ist
#   {-gui::page::%uuid%}        -> aktuelle Seite der Liste
#   {-gui::viewing::%uuid%}     -> ID des Reports in der Detailansicht
#   {-gui::slot::%uuid%::%n%}   -> Report-ID hinter Slot n der Liste
# =====================================================================

options:
    prefix: &8[&cReport&8]&r

# ------------------------- Hilfsfunktion -------------------------

function getOnlinePlayerByName(n: text) :: player:
    loop all players:
        if loop-player's name is {_n}:
            return loop-player

# ------------------------- /report Befehl -------------------------

command /report <offline player> <text>:
    aliases: /melden
    usage: &c/report <Spieler> <Grund>
    permission: reports.use
    permission message: {@prefix} &cDu darfst diesen Befehl nicht nutzen.
    cooldown: 30 seconds
    cooldown message: {@prefix} &cWarte noch %remaining time%, bevor du erneut meldest.
    cooldown bypass: reports.bypasscooldown
    trigger:
        if uuid of arg-1 is uuid of player:
            send "{@prefix} &cDu kannst dich nicht selbst melden!" to player
            stop trigger
        add 1 to {report-counter}
        set {_id} to {report-counter}
        set {reports::%{_id}%::reporter} to "%player's name%"
        set {reports::%{_id}%::reported} to "%name of arg-1%"
        set {reports::%{_id}%::reason} to "%arg-2%"
        set {reports::%{_id}%::time} to now
        set {reports::%{_id}%::status} to "open"
        add "%{_id}%" to {reports::open::*}
        send "{@prefix} &aDeine Meldung wurde übermittelt! &7(ID #%{_id}%)" to player
        loop all players:
            if loop-player has permission "reports.notify":
                send "{@prefix} &e%player's name%&7 hat &e%name of arg-1%&7 gemeldet &8(#%{_id}%)&7: &f%arg-2%" to loop-player
                play sound "entity.experience_orb.pickup" with volume 1 with pitch 1 to loop-player

# ------------------------- /reports Befehl (Admin) -------------------------

command /reports:
    aliases: /rlist, /reportadmin
    permission: reports.admin
    permission message: {@prefix} &cDu darfst diesen Befehl nicht nutzen.
    trigger:
        openReportList(player, 1)

command /clearreports:
    permission: reports.admin
    permission message: {@prefix} &cDu darfst diesen Befehl nicht nutzen.
    trigger:
        loop {reports::open::*}:
            delete {reports::%loop-value%::*}
        clear {reports::open::*}
        send "{@prefix} &aAlle offenen Reports wurden gelöscht." to player

# ------------------------- GUI: Liste -------------------------

function openReportList(p: player, page: integer):
    set {_total} to size of {reports::open::*}

    # Seitenzahl absichern (z.B. wenn die letzte Seite leer geworden ist)
    set {_maxpage} to ceil({_total} / 45)
    if {_maxpage} is less than 1:
        set {_maxpage} to 1
    if {_page} is greater than {_maxpage}:
        set {_page} to {_maxpage}
    if {_page} is less than 1:
        set {_page} to 1

    delete {-gui::slot::%uuid of {_p}%::*}
    set {_start} to ({_page} - 1) * 45
    set {_shown} to 0
    set {_index} to 0
    set {_gui} to chest inventory with 6 rows named "&8&lReports &7- Seite %{_page}%"

    loop {reports::open::*}:
        set {_id} to loop-value
        if {_index} is greater than or equal to {_start}:
            if {_shown} is less than 45:
                set {_item} to a book named "&c&lReport #%{_id}%"
                set lore of {_item} to "&7Gemeldet von: &f%{reports::%{_id}%::reporter}%" and "&7Spieler: &f%{reports::%{_id}%::reported}%" and "&7Grund: &f%{reports::%{_id}%::reason}%" and "&7Zeit: &f%{reports::%{_id}%::time}%" and "" and "&eKlicken für Aktionen"
                set slot {_shown} of {_gui} to {_item}
                set {-gui::slot::%uuid of {_p}%::%{_shown}%} to {_id}
                add 1 to {_shown}
        add 1 to {_index}

    if {_page} is greater than 1:
        set slot 45 of {_gui} to an arrow named "&a« Vorherige Seite"
    set slot 49 of {_gui} to a barrier named "&cSchließen"
    if ({_start} + 45) is less than {_total}:
        set slot 53 of {_gui} to an arrow named "&aNächste Seite »"

    open {_gui} to {_p}
    # WICHTIG: Status erst NACH dem Öffnen setzen, weil das Öffnen das
    # vorherige GUI schließt und dabei der Close-Handler den Status löscht.
    set {-gui::type::%uuid of {_p}%} to "list"
    set {-gui::page::%uuid of {_p}%} to {_page}

# ------------------------- GUI: Detailansicht -------------------------

function openReportDetail(p: player, id: text):
    set {_gui} to chest inventory with 3 rows named "&8&lReport #%{_id}% Details"

    set {_info} to a book named "&e&lInformationen"
    set lore of {_info} to "&7Melder: &f%{reports::%{_id}%::reporter}%" and "&7Gemeldet: &f%{reports::%{_id}%::reported}%" and "&7Grund: &f%{reports::%{_id}%::reason}%" and "&7Zeit: &f%{reports::%{_id}%::time}%" and "&7Status: &f%{reports::%{_id}%::status}%"
    set slot 4 of {_gui} to {_info}

    set {_tp} to a compass named "&b&lTeleportieren"
    set lore of {_tp} to "&7Teleportiere dich zu &f%{reports::%{_id}%::reported}%"
    set slot 11 of {_gui} to {_tp}

    set {_resolve} to a lime dye named "&a&lAls erledigt markieren"
    set slot 13 of {_gui} to {_resolve}

    set {_delete} to a red dye named "&c&lReport löschen"
    set slot 15 of {_gui} to {_delete}

    set {_back} to an arrow named "&7« Zurück zur Liste"
    set slot 22 of {_gui} to {_back}

    open {_gui} to {_p}
    set {-gui::type::%uuid of {_p}%} to "detail"
    set {-gui::viewing::%uuid of {_p}%} to {_id}

# ------------------------- Klick-Handling -------------------------

on inventory click:
    # Nur reagieren, wenn der Spieler gerade eines unserer Report-GUIs offen hat.
    # (Der Inventarname wird bewusst NICHT geprüft - die Farbcodes im Titel
    #  machten den alten Textvergleich kaputt.)
    set {_type} to {-gui::type::%uuid of player%}
    if {_type} is not set:
        stop trigger
    cancel event

    # Klicks ins eigene Inventar (unten) ignorieren
    if event-inventory is not player's current inventory:
        stop trigger

    set {_slot} to index of event-slot
    set {_page} to {-gui::page::%uuid of player%}
    if {_page} is not set:
        set {_page} to 1

    if {_type} is "list":
        if {_slot} is 49:
            close player's inventory
            stop trigger
        if {_slot} is 45:
            if {_page} is greater than 1:
                openReportList(player, {_page} - 1)
            stop trigger
        if {_slot} is 53:
            if event-slot is not air:
                openReportList(player, {_page} + 1)
            stop trigger
        set {_id} to {-gui::slot::%uuid of player%::%{_slot}%}
        if {_id} is set:
            if {reports::%{_id}%::status} is not set:
                send "{@prefix} &cDieser Report existiert nicht mehr." to player
                openReportList(player, {_page})
                stop trigger
            openReportDetail(player, {_id})

    else if {_type} is "detail":
        set {_id} to {-gui::viewing::%uuid of player%}
        if {_id} is not set:
            close player's inventory
            stop trigger

        if {_slot} is 22:
            openReportList(player, {_page})
            stop trigger

        # Report wurde in der Zwischenzeit von jemand anderem entfernt
        if {reports::%{_id}%::status} is not set:
            send "{@prefix} &cDieser Report existiert nicht mehr." to player
            openReportList(player, {_page})
            stop trigger

        if {_slot} is 11:
            set {_target} to getOnlinePlayerByName("%{reports::%{_id}%::reported}%")
            if {_target} is set:
                teleport player to {_target}
                send "{@prefix} &aDu wurdest zu %{reports::%{_id}%::reported}% teleportiert." to player
                close player's inventory
            else:
                send "{@prefix} &cDieser Spieler ist gerade nicht online." to player
            stop trigger

        if {_slot} is 13:
            set {reports::%{_id}%::status} to "resolved"
            remove "%{_id}%" from {reports::open::*}
            send "{@prefix} &aReport #%{_id}% wurde als erledigt markiert." to player
            openReportList(player, {_page})
            stop trigger

        if {_slot} is 15:
            delete {reports::%{_id}%::*}
            remove "%{_id}%" from {reports::open::*}
            send "{@prefix} &cReport #%{_id}% wurde gelöscht." to player
            openReportList(player, {_page})
            stop trigger

# ------------------------- Aufräumen -------------------------

on inventory close:
    delete {-gui::type::%uuid of player%}

on quit:
    delete {-gui::type::%uuid of player%}
    delete {-gui::page::%uuid of player%}
    delete {-gui::viewing::%uuid of player%}
    delete {-gui::slot::%uuid of player%::*}
