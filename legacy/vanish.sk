# =====================================================================
#   VANISH SYSTEM - Skript (korrigierte Version)
# =====================================================================
#   Benötigt: Skript 2.6+
#   Installation: nach /plugins/Skript/scripts/vanish.sk kopieren
#                 dann: /sk reload vanish
#
#   BEFEHLE:
#   /vanish [<Spieler>]   (Alias: /v)
#
#   PERMISSIONS:
#   vanish.use     -> darf sich selbst verstecken
#   vanish.others  -> darf andere verstecken
#   vanish.auto    -> automatisch unsichtbar beim Join
#   vanish.see     -> sieht versteckte Spieler trotzdem
#
#   EINSCHRÄNKUNG: Kisten-/Tür-Animationen und Tab-Completion anderer
#   Plugins lassen sich mit reinem Skript nicht verstecken.
# =====================================================================

options:
    prefix: &8[&5Vanish&8]&r

# ------------------------- Vanish an/aus -------------------------

function vanishOn(p: player):
    set {vanished::%uuid of {_p}%} to true
    loop all players:
        if loop-player is not {_p}:
            if loop-player does not have permission "vanish.see":
                hide {_p} from loop-player
    silence {_p}
    if {vanishon.silence} is not set:
        broadcast "<gray><red>[-]</red></gray> <gray>●</gray> <red>%{_p}%</red>"
    delete {vanishon.silence}   


function vanishOff(p: player):
    delete {vanished::%uuid of {_p}%}
    delete {vanishon.silence}
    unsilence {_p}
    loop all players:
        if loop-player is not {_p}:
            reveal {_p} from loop-player
    broadcast "<gray><green>[+]</green></gray> <gray>●</gray> <green>%{_p}%</green>"
    

# ------------------------- /vanish Befehl -------------------------

command /vanish [<player>]:
    aliases: v
    trigger:
        if arg-1 is set:
            if player does not have permission "vanish.others":
                send "{@prefix} &cDu darfst keine anderen Spieler verstecken." to player
                stop
            set {_target} to arg-1
        else:
            if player does not have permission "vanish.use":
                send "{@prefix} &cDu darfst diesen Befehl nicht nutzen." to player
                stop
            set {_target} to player
        if {vanished::%uuid of {_target}%} is set:
            vanishOff({_target})
            send "{@prefix} &eDu bist jetzt wieder sichtbar." to {_target}
            if {_target} is not player:
                send "{@prefix} &7Du hast %name of {_target}% sichtbar gemacht." to player
        else:
            vanishOn({_target})
            send "{@prefix} &aDu bist jetzt unsichtbar." to {_target}
            if {_target} is not player:
                send "{@prefix} &7Du hast %name of {_target}% unsichtbar gemacht." to player

# ------------------------- Beim Beitreten -------------------------

on join:
    # Auto-Vanish: Join-Nachricht unterdrücken
    if player has permission "vanish.auto":
        set {vanishon.silence} to true
        set join message to ""
    wait 1 tick
    # Bereits versteckte Spieler vor dem Neuankömmling verstecken
    if player does not have permission "vanish.see":
        loop all players:
            if loop-player is not player:
                if {vanished::%uuid of loop-player%} is set:
                    hide loop-player from player
    if player has permission "vanish.auto":
        vanishOn(player)
        send "{@prefix} &7Du bist automatisch unsichtbar (Auto-Vanish)." to player

# ------------------------- Beim Verlassen -------------------------

on quit:


# ------------------------- Server-Liste -------------------------

on server list ping:
    loop all players:
        if {vanished::%uuid of loop-player%} is set:
            hide loop-player from the server list

# ------------------------- Kein sichtbares Aufsammeln -------------------------

on pickup:
    if event-entity is a player:
        if {vanished::%uuid of event-entity%} is set:
            cancel the event
