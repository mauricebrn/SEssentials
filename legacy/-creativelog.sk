#
# CreativeLog - protokolliert alle Aktionen von Spielern im Kreativmodus,
# die NICHT die Berechtigung "Server.gamemodebypass" haben.
# Abruf: /creativelog <Spieler> [Seite]
#
# Benötigt: Skript (skriptlang) 2.6+
#

options:
    bypass-perm: Server.gamemodebypass
    view-perm: Server.creativelog
    max-entries: 1000
    page-size: 15

# --------------------------------------------------------------
# Hilfsfunktionen
# --------------------------------------------------------------

function cl_tracked(p: player) :: boolean:
    if {_p}'s gamemode is not creative:
        return false
    if {_p} has permission "{@bypass-perm}":
        return false
    return true

function cl_log(p: player, msg: text):
    set {_id} to uuid of {_p}
    set {creativelogname::%{_id}%} to name of {_p}
    add 1 to {creativelogcount::%{_id}%}
    set {_n} to {creativelogcount::%{_id}%}
    set {_time} to now formatted as "dd.MM.yyyy HH:mm:ss"
    set {creativelog::%{_id}%::%{_n}%} to "&7[%{_time}%] &f%{_msg}%"
    # alte Einträge löschen (Begrenzung)
    set {_old} to {_n} - {@max-entries}
    if {_old} > 0:
        delete {creativelog::%{_id}%::%{_old}%}

# --------------------------------------------------------------
# Gamemode-Wechsel
# --------------------------------------------------------------

on gamemode change:
    if event-gamemode is creative:
        if player doesn't have permission "{@bypass-perm}":
            cl_log(player, "&a>> Kreativmodus BETRETEN &7(Welt: %world of player%, Position: %floor(x-coord of player)% %floor(y-coord of player)% %floor(z-coord of player)%)")
    else if player's gamemode is creative:
        if player doesn't have permission "{@bypass-perm}":
            cl_log(player, "&c<< Kreativmodus VERLASSEN &7(neuer Modus: %event-gamemode%)")

on join:
    if cl_tracked(player) is true:
        cl_log(player, "&eServer betreten im Kreativmodus")

on quit:
    if cl_tracked(player) is true:
        cl_log(player, "&eServer verlassen im Kreativmodus")

# --------------------------------------------------------------
# Items aus dem Kreativ-Inventar nehmen / Inventar-Klicks
# --------------------------------------------------------------

on inventory click:
    if cl_tracked(player) is not true:
        stop
    set {_clicked} to event-item
    set {_cursor} to cursor slot of player
    if {_clicked} is set:
        if {_clicked} is not air:
            cl_log(player, "Inventar-Klick auf Item: &b%{_clicked}% &7(Anzahl: %amount of {_clicked}%)")
    if {_cursor} is set:
        if {_cursor} is not air:
            cl_log(player, "Item im Cursor/genommen: &b%{_cursor}% &7(Anzahl: %amount of {_cursor}%)")

on inventory open:
    if cl_tracked(player) is not true:
        stop
    cl_log(player, "Inventar/Container geöffnet: &b%type of event-inventory%")

# --------------------------------------------------------------
# Items aufheben / droppen
# --------------------------------------------------------------

on drop:
    if cl_tracked(player) is not true:
        stop
    cl_log(player, "Item gedroppt: &b%event-item% &7(Anzahl: %amount of event-item%)")

on pickup:
    if player is not set:
        stop
    if cl_tracked(player) is not true:
        stop
    cl_log(player, "Item aufgehoben: &b%event-item%")

# --------------------------------------------------------------
# Bloecke
# --------------------------------------------------------------

on place:
    if cl_tracked(player) is not true:
        stop
    cl_log(player, "Block platziert: &b%event-block% &7bei %floor(x-coord of event-block)% %floor(y-coord of event-block)% %floor(z-coord of event-block)% (%world of event-block%)")

on break:
    if cl_tracked(player) is not true:
        stop
    cl_log(player, "Block abgebaut: &b%event-block% &7bei %floor(x-coord of event-block)% %floor(y-coord of event-block)% %floor(z-coord of event-block)% (%world of event-block%)")

# --------------------------------------------------------------
# Interaktionen (Rechtsklick, Spawn-Eier, Eimer, ...)
# --------------------------------------------------------------

on right click:
    if cl_tracked(player) is not true:
        stop
    set {_tool} to player's tool
    if event-block is set:
        cl_log(player, "Rechtsklick auf Block &b%event-block% &7mit Item &b%{_tool}%")
    else if {_tool} is not air:
        cl_log(player, "Rechtsklick mit Item &b%{_tool}%")

on right click on entity:
    if cl_tracked(player) is not true:
        stop
    cl_log(player, "Rechtsklick auf Entity &b%event-entity% &7mit Item &b%player's tool%")

# --------------------------------------------------------------
# Kampf
# --------------------------------------------------------------

on damage:
    attacker is a player
    if cl_tracked(attacker) is not true:
        stop
    cl_log(attacker, "Schaden zugefügt an &b%victim% &7(%round(damage)% Schaden, Item: %attacker's tool%)")

# --------------------------------------------------------------
# Befehle
# --------------------------------------------------------------

on command:
    if sender is not a player:
        stop
    if cl_tracked(player) is not true:
        stop
    # Abfragebefehl selbst nicht loggen
    if command is "creativelog":
        stop
    cl_log(player, "Befehl: &6/%command% %arguments%")

# --------------------------------------------------------------
# Abrufbefehl: /creativelog <Spieler> [Seite]
# --------------------------------------------------------------

command /creativelog <offlineplayer> [<integer=1>]:
    usage: /creativelog <Spieler> [Seite]
    description: Zeigt die Kreativ-Aktionen eines Spielers an
    permission: {@view-perm}
    permission message: &cKeine Berechtigung!
    trigger:
        set {_id} to uuid of arg-1
        set {_count} to {creativelogcount::%{_id}%}
        if {_count} is not set:
            send "&cFür &e%arg-1% &cgibt es keine Kreativ-Logs."
            stop
        set {_page} to arg-2
        if {_page} < 1:
            set {_page} to 1
        set {_size} to {@page-size}
        set {_start} to {_count} - (({_page} - 1) * {_size})
        if {_start} < 1:
            send "&cDiese Seite existiert nicht."
            stop
        set {_end} to {_start} - {_size} + 1
        if {_end} < 1:
            set {_end} to 1
        set {_pages} to ceil({_count} / {_size})
        send "&8&m----------&r &6Kreativ-Log: &e%arg-1% &7(Seite %{_page}%/%{_pages}%) &8&m----------"
        set {_i} to {_start}
        while {_i} >= {_end}:
            if {creativelog::%{_id}%::%{_i}%} is set:
                send {creativelog::%{_id}%::%{_i}%}
            remove 1 from {_i}
        send "&7Neueste Einträge zuerst. Nächste Seite: &e/creativelog %arg-1% %{_page} + 1%"
