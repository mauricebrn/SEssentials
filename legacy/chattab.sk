options:
    prefix: &8[&7Server&8]&r
    footer: <green>www.quercon.com<reset> <gray>● ©2026 Quercon
    header: <gray>Welcome to the Server!

on chat:
    # Skip messages that are input for the news editor
    {-news.input::%uuid of player%} is not set
    player has permission "chattab.chat"
    cancel event
    set {_lp} to luckperms user from player
    set {_pprefix} to formatted luckperms prefix of user {_lp}
    set {_msg} to uncolored message
    broadcast "%{_pprefix}%<reset><gray> ● %player%: %{_msg}%"

function setTab(p: player):
    set {_lp} to luckperms user from {_p}
    set {_pprefix} to formatted luckperms prefix of user {_lp}
    set {_p}'s tab list name to "%{_pprefix}%<reset> <gray>● %{_p}%"
    set {_p}'s tab list header to "{@header}"
    set {_p}'s tab list footer to "{@footer}"
    setNametag({_p}, {_pprefix})

function setNametag(p: player, pprefix: text):
    # One team per player, so everyone can have their own prefix
    set {_team} to team named "nt_%uuid of {_p}%"
    set team prefix of {_team} to "%{_pprefix}% §7● "
    set team color of {_team} to gray
    add {_p} to team entries of {_team}

on join:
    if {vanished::%uuid of player%} is not set:
        set the join message to "<green>[+]<reset> <gray>● <green>%player%"
    setTab(player)

on quit:
    if {vanished::%uuid of player%} is not set:
        set the quit message to "<red>[-]<reset> <gray>● <red>%player%"

# Refresh everyone's tab name and nametag (e.g. after changing ranks)
command /refreshtab:
    permission: chattab.admin
    trigger:
        loop all players:
            setTab(loop-player)
        send "{@prefix} <green>Tab list and nametags refreshed." to sender
