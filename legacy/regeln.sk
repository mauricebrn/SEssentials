# ============================================================
#  REGEL-SYSTEM  (für das Plugin "Skript", getestet ab 2.8)
#  Im Stil des News-Systems.
#
#  Spieler:
#    /regeln                -> Regel-Übersicht (Kurzversion, klickbar)
#    /regeln <nr>           -> Vollständige Regel mit Strafe
#    /regeln akzeptieren    -> Regeln bestätigen
#
#  Admins (Permission: rules.admin):
#    /regeladmin            -> Admin-Panel (GUI)
#    /regeladmin edit <id>
#    /regeladmin rollout    -> Rollout-Tracker (wer hat akzeptiert?)
#
#  Formatierung im Inhalt:
#    &a, &l ...            -> Farbcodes
#    [Text](/befehl)       -> klickbarer Befehl
#    \n                    -> Zeilenumbruch
# ============================================================

options:
    perm: rules.admin
    prefix: &6&lRegeln &8»
    joindelay: 4 seconds
    line: &8&m                                                   
    # Leerzeilen zum Leeren des Chats beim Navigieren
    clearlines: 100

# ------------------------------------------------------------
#  Hilfsfunktionen
# ------------------------------------------------------------

function rules_clear(p: player):
    loop {@clearlines} times:
        send " " to {_p}

function rules_ver() :: number:
    if {rules.version} is set:
        return {rules.version}
    return 1

function rules_exists(id: number) :: boolean:
    if {rules::%{_id}%::title} is set:
        return true
    return false

# Alle sichtbaren Regeln in der richtigen Reihenfolge (IDs)
function rules_visible() :: numbers:
    loop {rules.order::*}:
        if {rules::%loop-value%::visible} is true:
            add loop-value to {_ids::*}
    return {_ids::*}

# Nummer, die Spieler für diese Regel sehen (0 = nicht sichtbar)
function rules_number(id: number) :: number:
    set {_ids::*} to rules_visible()
    loop {_ids::*}:
        if loop-value = {_id}:
            return loop-index parsed as integer
    return 0

# Position in der Gesamtliste (auch unsichtbare Regeln)
function rules_pos(id: number) :: number:
    loop {rules.order::*}:
        if loop-value = {_id}:
            return loop-index parsed as integer
    return 0

function rules_date(d: date) :: text:
    return {_d} formatted as "dd.MM.yyyy HH:mm"

# Sucht das letzte Vorkommen eines Zeichens (1-basiert, 0 = nicht gefunden).
function rules_last_index(needle: text, t: text) :: number:
    set {_i} to length of {_t}
    while {_i} >= 1:
        if subtext of {_t} from characters {_i} to {_i} is {_needle}:
            return {_i}
        remove 1 from {_i}
    return 0

# Wandelt [Text](/befehl) in klickbare Links um.
# links = false -> nur der Text wird angezeigt (für Kurzversionen)
function rules_render(t: text, links: boolean) :: text:
    set {_out} to ""
    set {_r} to {_t}
    loop 50 times:
        if {_r} does not contain "](/":
            exit loop
        set {_mid} to index of "](/" in {_r}
        if {_mid} <= 1:
            exit loop
        set {_head} to first ({_mid} - 1) characters of {_r}
        set {_open} to rules_last_index("[", {_head})
        if {_open} < 1:
            exit loop
        set {_after} to subtext of {_r} from characters ({_mid} + 2) to (length of {_r})
        set {_close} to index of ")" in {_after}
        if {_close} < 2:
            exit loop
        set {_cmd} to first ({_close} - 1) characters of {_after}
        if {_open} < length of {_head}:
            set {_label} to subtext of {_head} from characters ({_open} + 1) to (length of {_head})
        else:
            set {_label} to {_cmd}
        set {_before} to ""
        if {_open} > 1:
            set {_before} to first ({_open} - 1) characters of {_head}
        if {_links} is true:
            set {_out} to "%{_out}%%{_before}%<cmd:%{_cmd}%><ttp:Klicken zum Ausführen: %{_cmd}%>&b&n%{_label}%<reset>"
        else:
            set {_out} to "%{_out}%%{_before}%&b%{_label}%&7"
        if {_close} < length of {_after}:
            set {_r} to subtext of {_after} from characters ({_close} + 1) to (length of {_after})
        else:
            set {_r} to ""
    return "%{_out}%%{_r}%"

function rules_short(id: number, max: number) :: text:
    set {_s} to rules_render({rules::%{_id}%::content}, false)
    set {_s} to uncolored {_s}
    replace all "\n" with " " in {_s}
    if length of {_s} > {_max}:
        set {_s} to "%first ({_max} - 3) characters of {_s}%..."
    return {_s}

function rules_item(type: itemtype, name: text, lore: texts) :: item:
    set {_i} to {_type} named (colored {_name})
    set {_c::*} to colored {_lore::*}
    set {_i} to {_i} with lore {_c::*}
    return {_i}

# Hat dieser Spieler (UUID) die aktuelle Version akzeptiert?
function rules_has_accepted(uuid: text) :: boolean:
    if {rules.accepted::%{_uuid}%} is not set:
        return false
    if {rules.accepted::%{_uuid}%} < rules_ver():
        return false
    return true

# Muss der Spieler die (neue) Version noch akzeptieren?
function rules_needs_accept(p: player) :: boolean:
    set {_ids::*} to rules_visible()
    if size of {_ids::*} = 0:
        return false
    if rules_has_accepted("%uuid of {_p}%") is true:
        return false
    return true

# ------------------------------------------------------------
#  Rollout-Statistik
# ------------------------------------------------------------

# Gibt [akzeptiert, gesamt] für die aktuelle Version zurück
function rules_stats() :: numbers:
    set {_acc} to 0
    set {_total} to 0
    loop {rules.known::*}:
        add 1 to {_total}
        if rules_has_accepted(loop-index) is true:
            add 1 to {_acc}
    return {_acc}, {_total}

function rules_pct(acc: number, total: number) :: number:
    if {_total} <= 0:
        return 0
    return round({_acc} * 100 / {_total})

# Fortschrittsbalken aus 20 Strichen
function rules_bar(acc: number, total: number) :: text:
    set {_full} to 0
    if {_total} > 0:
        set {_full} to round({_acc} * 20 / {_total})
    set {_bar} to "&a"
    set {_i} to 0
    while {_i} < 20:
        if {_i} = {_full}:
            set {_bar} to "%{_bar}%&8"
        set {_bar} to "%{_bar}%|"
        add 1 to {_i}
    return {_bar}

# ------------------------------------------------------------
#  Spieler-Ansicht
# ------------------------------------------------------------

function rules_feed(p: player, clear: boolean = true):
    if {_clear} is true:
        rules_clear({_p})
    set {_ids::*} to rules_visible()
    if size of {_ids::*} = 0:
        send formatted "{@prefix} &7Es sind noch keine Regeln eingetragen." to {_p}
        stop
    send formatted "{@line}" to {_p}
    send formatted " &6&l§ REGELN &8» &7%size of {_ids::*}% Regel(n) &8- &7Klicke für Details" to {_p}
    send "" to {_p}
    loop {_ids::*}:
        set {_n} to loop-index
        set {_id} to loop-value
        set {_title} to {rules::%{_id}%::title}
        set {_short} to rules_short({_id}, 40)
        set {_line} to " <cmd:/regeln %{_n}%><ttp:Klicke für die ganze Regel>&8[&6§%{_n}%&8] &f&l%{_title}% &8» &7%{_short}%<reset>"
        send formatted {_line} to {_p}
    if rules_needs_accept({_p}) is true:
        send "" to {_p}
        send formatted " <cmd:/regeln akzeptieren><ttp:Bestätigt, dass du die Regeln gelesen hast>&a&l[✔ Regeln akzeptieren]<reset>" to {_p}
    send formatted "{@line}" to {_p}

# n = angezeigte Nummer, nav = Blätter-Knöpfe anzeigen
function rules_show(p: player, id: number, n: number, nav: boolean = true, clear: boolean = true):
    if {_clear} is true:
        rules_clear({_p})
    set {_title} to {rules::%{_id}%::title}
    set {_c} to rules_render({rules::%{_id}%::content}, true)
    set {_lines::*} to {_c} split at "\n"
    send formatted "{@line}" to {_p}
    if {_n} > 0:
        send formatted " &6&l§%{_n}% &8| &f&l%{_title}%" to {_p}
    else:
        send formatted " &7&l(unsichtbar) &8| &f&l%{_title}%" to {_p}
    send "" to {_p}
    loop {_lines::*}:
        set {_l} to " &f%loop-value%"
        send formatted {_l} to {_p}
    if {rules::%{_id}%::strafe} is set:
        send "" to {_p}
        send formatted " &c&l⚠ Strafe: &7%{rules::%{_id}%::strafe}%" to {_p}
    send "" to {_p}
    if {_nav} is true:
        set {_ids::*} to rules_visible()
        set {_out} to " <cmd:/regeln><ttp:Zurück zur Übersicht>&8[&7« Alle Regeln&8]<reset>"
        if {_n} > 1:
            set {_prev} to {_n} - 1
            set {_out} to "%{_out}% <cmd:/regeln %{_prev}%><ttp:Vorherige Regel>&8[&e‹ §%{_prev}%&8]<reset>"
        if {_n} < size of {_ids::*}:
            set {_next} to {_n} + 1
            set {_out} to "%{_out}% <cmd:/regeln %{_next}%><ttp:Nächste Regel>&8[&e§%{_next}% ›&8]<reset>"
        send formatted {_out} to {_p}
    send formatted "{@line}" to {_p}

# Hinweis für Spieler, die noch akzeptieren müssen
function rules_notify(p: player):
    send formatted "{@line}" to {_p}
    if {rules.accepted::%uuid of {_p}%} is set:
        send formatted " &6&l§ REGELN &8» &eDie Regeln wurden aktualisiert!" to {_p}
    else:
        send formatted " &6&l§ REGELN &8» &eBitte lies unsere Regeln." to {_p}
    send formatted " <cmd:/regeln><ttp:Regeln anzeigen>&8[&b📖 Regeln lesen&8]<reset> <cmd:/regeln akzeptieren><ttp:Bestätigt, dass du die Regeln gelesen hast>&8[&a✔ Akzeptieren&8]<reset>" to {_p}
    send formatted "{@line}" to {_p}

on join:
    # Für den Rollout-Tracker: jeden Spieler einmal erfassen (Name wird aktualisiert)
    set {rules.known::%uuid of player%} to name of player
    wait {@joindelay}
    player is online
    rules_needs_accept(player) is true
    rules_notify(player)

command /regeln [<text>]:
    aliases: /rules, /regel
    executable by: players
    trigger:
        if arg-1 is "akzeptieren" or "accept":
            set {_ids::*} to rules_visible()
            if size of {_ids::*} = 0:
                send formatted "{@prefix} &7Es gibt keine Regeln zum Akzeptieren."
                stop
            if rules_needs_accept(player) is false:
                send formatted "{@prefix} &7Du hast die Regeln bereits akzeptiert."
                stop
            set {_ver} to rules_ver()
            set {rules.accepted::%uuid of player%} to {_ver}
            set {rules.log::%{_ver}%::%uuid of player%} to now
            set {rules.known::%uuid of player%} to name of player
            send formatted "{@prefix} &aDanke! Du hast die Regeln akzeptiert."
            stop
        if arg-1 is set:
            set {_n} to arg-1 parsed as integer
            if {_n} is not set:
                send formatted "{@prefix} &cBenutze: /regeln <nr>"
                stop
            set {_ids::*} to rules_visible()
            if {_ids::%{_n}%} is not set:
                send formatted "{@prefix} &cRegel §%{_n}% existiert nicht."
                stop
            rules_show(player, {_ids::%{_n}%}, {_n}, true, true)
            stop
        rules_feed(player, true)

# ------------------------------------------------------------
#  Admin-Panel
# ------------------------------------------------------------

function rules_create() :: number:
    if {rules.version} is not set:
        set {rules.version} to 1
    add 1 to {rules.nextid}
    set {_id} to {rules.nextid}
    set {rules::%{_id}%::title} to "Neue Regel"
    set {rules::%{_id}%::content} to "Hier steht die Regel. [Alle Regeln](/regeln)"
    set {rules::%{_id}%::created} to now
    set {rules::%{_id}%::visible} to false
    add {_id} to {rules.order::*}
    return {_id}

function rules_delete(id: number):
    delete {rules::%{_id}%::*}
    set {_new::*} to {rules.order::*}
    loop {_new::*}:
        if loop-value = {_id}:
            delete {_new::%loop-index%}
    delete {rules.order::*}
    # neu durchnummerieren (1, 2, 3 ...)
    set {rules.order::*} to {_new::*}

function rules_toggle(id: number):
    if {rules::%{_id}%::visible} is true:
        set {rules::%{_id}%::visible} to false
    else:
        set {rules::%{_id}%::visible} to true

# dir = -1 -> nach oben, 1 -> nach unten
function rules_move(id: number, dir: number):
    set {_i} to rules_pos({_id})
    if {_i} < 1:
        stop
    set {_j} to {_i} + {_dir}
    if {rules.order::%{_j}%} is not set:
        stop
    set {_other} to {rules.order::%{_j}%}
    set {rules.order::%{_j}%} to {_id}
    set {rules.order::%{_i}%} to {_other}

function rules_panel(p: player):
    set {_u} to uuid of {_p}
    set {_gui} to chest inventory with 6 rows named "&8Regel-Verwaltung"
    delete {-rules.slots::%{_u}%::*}
    set {_slot} to 0
    loop {rules.order::*}:
        if {_slot} >= 45:
            exit loop
        set {_id} to loop-value
        set {_n} to rules_number({_id})
        set {_mat} to written book
        set {_st} to "&aSichtbar &7(§%{_n}%)"
        if {rules::%{_id}%::visible} is not true:
            set {_mat} to gray dye
            set {_st} to "&7Unsichtbar"
        set {_str} to "&7keine"
        if {rules::%{_id}%::strafe} is set:
            set {_str} to "&c%{rules::%{_id}%::strafe}%"
        set {_short} to rules_short({_id}, 35)
        delete {_lore::*}
        set {_lore::*} to "&7Status: %{_st}%", "&7Position: &f%loop-index%", "&7Strafe: %{_str}%", "", "&8%{_short}%", "", "&eLinksklick &7» Bearbeiten", "&eRechtsklick &7» Sichtbarkeit umschalten", "&eShift + Links &7» nach oben", "&eShift + Rechts &7» nach unten"
        set slot {_slot} of {_gui} to rules_item({_mat}, "&f&l%{rules::%{_id}%::title}% &8(ID %{_id}%)", {_lore::*})
        set {-rules.slots::%{_u}%::%{_slot}%} to {_id}
        add 1 to {_slot}
    set {_l::*} to "&7Zeigt die Übersicht so,", "&7wie Spieler sie sehen."
    set slot 45 of {_gui} to rules_item(spyglass, "&e&lVorschau", {_l::*})
    set {_l::*} to "&7Aktuelle Version: &f%rules_ver()%", "", "&7Nach wichtigen Änderungen erhöhen,", "&7damit alle Spieler die Regeln", "&7erneut akzeptieren müssen.", "", "&cShift + Klick &7» Neue Version"
    set slot 47 of {_gui} to rules_item(bell, "&6&lAkzeptanz-Version", {_l::*})
    set {_l::*} to "&7Erstellt eine neue Regel", "&7(zunächst unsichtbar)."
    set slot 49 of {_gui} to rules_item(emerald, "&a&l+ Neue Regel", {_l::*})
    set {_st::*} to rules_stats()
    set {_l::*} to "&7Version &f%rules_ver()%&7: &a%{_st::1}% &8/ &f%{_st::2}% &7(%rules_pct({_st::1}, {_st::2})%%%)", rules_bar({_st::1}, {_st::2}), "", "&eKlick &7» Tracker öffnen"
    set slot 51 of {_gui} to rules_item(player head, "&b&lRollout-Tracker", {_l::*})
    set {_l::*} to "&7Panel schließen."
    set slot 53 of {_gui} to rules_item(barrier, "&c&lSchließen", {_l::*})
    open {_gui} to {_p}
    set {-rules.gui::%{_u}%} to "panel"

function rules_editor(p: player, id: number):
    set {_u} to uuid of {_p}
    set {_gui} to chest inventory with 3 rows named "&8Regel ID %{_id}% bearbeiten"
    set {_title} to {rules::%{_id}%::title}
    set {_short} to rules_short({_id}, 35)

    set {_l::*} to "&7Aktuell: &f%{_title}%", "", "&eKlick &7» Neuen Titel eingeben"
    set slot 10 of {_gui} to rules_item(name tag, "&e&lTitel", {_l::*})

    set {_l::*} to "&7Aktuell: &8%{_short}%", "", "&7Link: &f[Text](/befehl)", "&7Umbruch: &f\n", "&7Farben: &f&&a, &&l ...", "", "&eKlick &7» Neuen Inhalt eingeben"
    set slot 11 of {_gui} to rules_item(writable book, "&e&lInhalt ersetzen", {_l::*})

    set {_l::*} to "&7Hängt Text an den Inhalt an.", "&7(für lange Texte über 256 Zeichen)", "", "&eKlick &7» Text anhängen"
    set slot 12 of {_gui} to rules_item(feather, "&e&lInhalt ergänzen", {_l::*})

    set {_str} to "&7keine"
    if {rules::%{_id}%::strafe} is set:
        set {_str} to "&c%{rules::%{_id}%::strafe}%"
    set {_l::*} to "&7Aktuell: %{_str}%", "", "&eLinksklick &7» Strafe festlegen", "&eRechtsklick &7» Strafe entfernen"
    set slot 13 of {_gui} to rules_item(iron sword, "&e&lStrafe", {_l::*})

    set {_l::*} to "&7Position: &f%rules_pos({_id})% &7von &f%size of {rules.order::*}%", "", "&eLinksklick &7» nach oben", "&eRechtsklick &7» nach unten"
    set slot 14 of {_gui} to rules_item(ladder, "&e&lReihenfolge", {_l::*})

    set {_l::*} to "", "&eKlick &7» Sichtbar / Unsichtbar"
    if {rules::%{_id}%::visible} is true:
        set slot 16 of {_gui} to rules_item(lime dye, "&a&lSichtbar &7(§%rules_number({_id})%)", {_l::*})
    else:
        set slot 16 of {_gui} to rules_item(gray dye, "&7&lUnsichtbar", {_l::*})

    set {_l::*} to "&7Zeigt die vollständige", "&7Regel im Chat."
    set slot 22 of {_gui} to rules_item(spyglass, "&b&lVorschau", {_l::*})

    set {_l::*} to "&7Zurück zur Übersicht."
    set slot 18 of {_gui} to rules_item(arrow, "&7&l« Zurück", {_l::*})

    set {_l::*} to "&7Löscht diese Regel endgültig.", "", "&cShift + Klick &7» Löschen"
    set slot 26 of {_gui} to rules_item(tnt, "&c&lLöschen", {_l::*})

    open {_gui} to {_p}
    set {-rules.gui::%{_u}%} to "editor"
    set {-rules.edit::%{_u}%} to {_id}

# ------------------------------------------------------------
#  Rollout-Tracker (GUI)
#  filter: "accepted" oder "pending"
# ------------------------------------------------------------

function rules_rollout(p: player, filter: text = "accepted", page: number = 1):
    set {_u} to uuid of {_p}
    set {_ver} to rules_ver()

    # Spieler aufteilen (Index = UUID, Wert = Name)
    loop {rules.known::*}:
        if rules_has_accepted(loop-index) is true:
            set {_acc::%loop-index%} to loop-value
        else:
            set {_pend::%loop-index%} to loop-value
    set {_nacc} to size of {_acc::*}
    set {_npend} to size of {_pend::*}
    set {_total} to {_nacc} + {_npend}

    if {_filter} is "pending":
        set {_show::*} to {_pend::*}
        set {_ftitle} to "Ausstehend"
    else:
        set {_filter} to "accepted"
        set {_show::*} to {_acc::*}
        set {_ftitle} to "Akzeptiert"

    set {_pages} to ceil(size of {_show::*} / 45)
    if {_pages} < 1:
        set {_pages} to 1
    if {_page} > {_pages}:
        set {_page} to {_pages}
    if {_page} < 1:
        set {_page} to 1

    set {_gui} to chest inventory with 6 rows named "&8Rollout v%{_ver}% &7» %{_ftitle}% (%{_page}%/%{_pages}%)"

    # Köpfe der aktuellen Seite
    set {_start} to ({_page} - 1) * 45
    set {_i} to 0
    set {_slot} to 0
    loop {_show::*}:
        if {_slot} >= 45:
            exit loop
        if {_i} >= {_start}:
            set {_uuid} to loop-index
            set {_op} to offlineplayer({_uuid})
            set {_online} to "&7Offline"
            if {_op} is online:
                set {_online} to "&aOnline"
            delete {_lore::*}
            if {_filter} is "accepted":
                set {_when} to "&8unbekannt"
                if {rules.log::%{_ver}%::%{_uuid}%} is set:
                    set {_when} to "&f%rules_date({rules.log::%{_ver}%::%{_uuid}%})%"
                set {_lore::*} to "&a✔ Akzeptiert", "&7Am: %{_when}%", "&7Status: %{_online}%"
            else:
                set {_last} to "&7Noch nie akzeptiert"
                if {rules.accepted::%{_uuid}%} is set:
                    set {_last} to "&7Zuletzt: &fVersion %{rules.accepted::%{_uuid}%}%"
                set {_lore::*} to "&c✘ Ausstehend", {_last}, "&7Status: %{_online}%"
            set {_c::*} to colored {_lore::*}
            set {_head} to (skull of {_op}) named (colored "&f%loop-value%")
            set {_head} to {_head} with lore {_c::*}
            set slot {_slot} of {_gui} to {_head}
            add 1 to {_slot}
        add 1 to {_i}

    # Statistik
    set {_pct} to rules_pct({_nacc}, {_total})
    set {_onpend} to 0
    loop all players:
        if rules_has_accepted("%uuid of loop-player%") is false:
            add 1 to {_onpend}
    delete {_l::*}
    set {_l::*} to "&7Version: &f%{_ver}%", "&7Akzeptiert: &a%{_nacc}% &8/ &f%{_total}% &7(%{_pct}%%%)", rules_bar({_nacc}, {_total}), "&7Ausstehend: &c%{_npend}% &8(&7davon online: &f%{_onpend}%&8)", "", "&7Frühere Versionen:"
    set {_v} to {_ver} - 1
    set {_shown} to 0
    while {_v} >= 1:
        if {_shown} >= 5:
            exit loop
        add "&8 v%{_v}%: &7%size of {rules.log::%{_v}%::*}% Bestätigungen" to {_l::*}
        remove 1 from {_v}
        add 1 to {_shown}
    if {_shown} = 0:
        add "&8 keine" to {_l::*}
    set slot 49 of {_gui} to rules_item(book, "&b&lStatistik", {_l::*})

    # Navigation
    set {_l::*} to "&7Zurück zum Panel."
    set slot 45 of {_gui} to rules_item(arrow, "&7&l« Zurück", {_l::*})
    if {_filter} is "accepted":
        set {_l::*} to "&7Aktuell: &aAkzeptiert", "", "&eKlick &7» Ausstehende zeigen"
    else:
        set {_l::*} to "&7Aktuell: &cAusstehend", "", "&eKlick &7» Akzeptierte zeigen"
    set slot 47 of {_gui} to rules_item(hopper, "&e&lFilter", {_l::*})
    if {_page} > 1:
        set {_l::*} to "&7Seite %{_page} - 1%"
        set slot 48 of {_gui} to rules_item(arrow, "&e&l‹ Vorherige Seite", {_l::*})
    if {_page} < {_pages}:
        set {_l::*} to "&7Seite %{_page} + 1%"
        set slot 50 of {_gui} to rules_item(arrow, "&e&lNächste Seite ›", {_l::*})
    set {_l::*} to "&7Schickt allen Online-Spielern,", "&7die noch nicht akzeptiert haben,", "&7einen Hinweis.", "", "&7Betrifft: &f%{_onpend}% &7Spieler", "", "&eKlick &7» Erinnern"
    set slot 51 of {_gui} to rules_item(bell, "&6&lErinnern", {_l::*})
    set {_l::*} to "&7Tracker schließen."
    set slot 53 of {_gui} to rules_item(barrier, "&c&lSchließen", {_l::*})

    open {_gui} to {_p}
    set {-rules.gui::%{_u}%} to "rollout"
    set {-rules.rfilter::%{_u}%} to {_filter}
    set {-rules.rpage::%{_u}%} to {_page}

function rules_prompt(p: player, mode: text, id: number, what: text):
    set {-rules.input::%uuid of {_p}%} to {_mode}
    set {-rules.edit::%uuid of {_p}%} to {_id}
    close {_p}'s inventory
    rules_clear({_p})
    send formatted "{@prefix} &7Gib %{_what}% im Chat ein:" to {_p}
    if {_mode} is "content" or "append":
        send formatted " &8- &7Klickbarer Befehl: &f[Alle Regeln](/regeln)" to {_p}
        send formatted " &8- &7Zeilenumbruch: &f\n &8| &7Farben: &f&&a &&l ..." to {_p}
    if {_mode} is "strafe":
        send formatted " &8- &7z. B. &f1 Tag Bann&7, &fVerwarnung&7, &fPermanenter Bann" to {_p}
    send formatted " <cmd:/regeladmin cancel><ttp:Eingabe abbrechen>&c[Abbrechen]<reset> &8(oder &7abbrechen &8schreiben)" to {_p}

command /regeladmin [<text>] [<integer>]:
    aliases: /rulesadmin
    permission: {@perm}
    permission message: &cDazu hast du keine Rechte.
    executable by: players
    trigger:
        set {_u} to uuid of player
        if arg-1 is "cancel":
            if {-rules.input::%{_u}%} is set:
                delete {-rules.input::%{_u}%}
                send formatted "{@prefix} &7Eingabe abgebrochen."
                if rules_exists({-rules.edit::%{_u}%}) is true:
                    rules_editor(player, {-rules.edit::%{_u}%})
            stop
        if arg-1 is "edit":
            if rules_exists(arg-2) is false:
                send formatted "{@prefix} &cDiese Regel existiert nicht."
                stop
            rules_editor(player, arg-2)
            stop
        if arg-1 is "rollout" or "tracker":
            rules_rollout(player, "accepted", 1)
            stop
        rules_panel(player)

# ------------------------------------------------------------
#  GUI-Klicks
# ------------------------------------------------------------

on inventory click:
    set {_u} to uuid of player
    {-rules.gui::%{_u}%} is set
    cancel event
    event-inventory is not player's inventory
    if player does not have permission "{@perm}":
        close player's inventory
        stop
    set {_gui} to {-rules.gui::%{_u}%}
    set {_slot} to index of event-slot
    set {_right} to false
    set {_shift} to false
    if click type is right mouse button or right mouse button with shift:
        set {_right} to true
    if click type is left mouse button with shift or right mouse button with shift:
        set {_shift} to true
    wait 1 tick

    # --- Übersicht ---
    if {_gui} is "panel":
        if {_slot} < 45:
            set {_id} to {-rules.slots::%{_u}%::%{_slot}%}
            {_id} is set
            if {_shift} is true:
                if {_right} is true:
                    rules_move({_id}, 1)
                else:
                    rules_move({_id}, -1)
                rules_panel(player)
            else if {_right} is true:
                rules_toggle({_id})
                rules_panel(player)
            else:
                rules_editor(player, {_id})
        else if {_slot} = 45:
            close player's inventory
            rules_feed(player, true)
        else if {_slot} = 47:
            if {_shift} is true:
                set {rules.version} to rules_ver() + 1
                send formatted "{@prefix} &aVersion auf &f%{rules.version}% &aerhöht. Alle Spieler müssen die Regeln erneut akzeptieren."
                rules_panel(player)
            else:
                send formatted "{@prefix} &7Zum Erhöhen &cShift + Klick &7benutzen."
        else if {_slot} = 49:
            set {_id} to rules_create()
            rules_editor(player, {_id})
        else if {_slot} = 51:
            rules_rollout(player, "accepted", 1)
        else if {_slot} = 53:
            close player's inventory
        stop

    # --- Rollout-Tracker ---
    if {_gui} is "rollout":
        set {_filter} to {-rules.rfilter::%{_u}%}
        set {_page} to {-rules.rpage::%{_u}%}
        if {_slot} = 45:
            rules_panel(player)
        else if {_slot} = 47:
            if {_filter} is "accepted":
                rules_rollout(player, "pending", 1)
            else:
                rules_rollout(player, "accepted", 1)
        else if {_slot} = 48:
            rules_rollout(player, {_filter}, {_page} - 1)
        else if {_slot} = 50:
            rules_rollout(player, {_filter}, {_page} + 1)
        else if {_slot} = 51:
            set {_count} to 0
            loop all players:
                if rules_needs_accept(loop-player) is true:
                    rules_notify(loop-player)
                    add 1 to {_count}
            send formatted "{@prefix} &a%{_count}% &7Spieler wurden erinnert."
        else if {_slot} = 53:
            close player's inventory
        stop

    # --- Editor ---
    set {_id} to {-rules.edit::%{_u}%}
    if rules_exists({_id}) is false:
        close player's inventory
        stop
    if {_slot} = 10:
        rules_prompt(player, "title", {_id}, "den neuen &fTitel")
    else if {_slot} = 11:
        rules_prompt(player, "content", {_id}, "den neuen &fInhalt")
    else if {_slot} = 12:
        rules_prompt(player, "append", {_id}, "den &fanzuhängenden Text")
    else if {_slot} = 13:
        if {_right} is true:
            delete {rules::%{_id}%::strafe}
            rules_editor(player, {_id})
        else:
            rules_prompt(player, "strafe", {_id}, "die &fStrafe")
    else if {_slot} = 14:
        if {_right} is true:
            rules_move({_id}, 1)
        else:
            rules_move({_id}, -1)
        rules_editor(player, {_id})
    else if {_slot} = 16:
        rules_toggle({_id})
        rules_editor(player, {_id})
    else if {_slot} = 22:
        close player's inventory
        rules_show(player, {_id}, rules_number({_id}), false, true)
        send formatted " <cmd:/regeladmin edit %{_id}%><ttp:Zurück zum Editor>&8[&e« Zurück zum Editor&8]<reset>"
    else if {_slot} = 18:
        rules_panel(player)
    else if {_slot} = 26:
        if {_shift} is true:
            rules_delete({_id})
            send formatted "{@prefix} &cRegel ID %{_id}% wurde gelöscht."
            rules_panel(player)
        else:
            send formatted "{@prefix} &7Zum Löschen &cShift + Klick &7benutzen."

on inventory close:
    delete {-rules.gui::%uuid of player%}

on quit:
    delete {-rules.gui::%uuid of player%}
    delete {-rules.input::%uuid of player%}
    delete {-rules.edit::%uuid of player%}
    delete {-rules.rfilter::%uuid of player%}
    delete {-rules.rpage::%uuid of player%}

# ------------------------------------------------------------
#  Chat-Eingabe
# ------------------------------------------------------------

on chat with priority lowest:
    set {_u} to uuid of player
    {-rules.input::%{_u}%} is set
    cancel event
    set {_mode} to {-rules.input::%{_u}%}
    set {_id} to {-rules.edit::%{_u}%}
    set {_m} to message
    delete {-rules.input::%{_u}%}
    wait 1 tick
    player is online
    if rules_exists({_id}) is false:
        send formatted "{@prefix} &cDiese Regel existiert nicht mehr."
        stop
    if {_m} is "abbrechen":
        send formatted "{@prefix} &7Eingabe abgebrochen."
        rules_editor(player, {_id})
        stop

    if {_mode} is "title":
        set {rules::%{_id}%::title} to {_m}
    else if {_mode} is "content":
        set {rules::%{_id}%::content} to {_m}
    else if {_mode} is "append":
        set {rules::%{_id}%::content} to "%{rules::%{_id}%::content}% %{_m}%"
    else if {_mode} is "strafe":
        if {_m} is "keine":
            delete {rules::%{_id}%::strafe}
        else:
            set {rules::%{_id}%::strafe} to {_m}

    send formatted "{@prefix} &aGespeichert."
    rules_editor(player, {_id})
