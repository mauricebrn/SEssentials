# =====================================================================
#   SOFT RESTART SYSTEM - Skript
# =====================================================================
#
#   Benötigt: Skript 2.6+ (https://hangar.papermc.io/SkriptLang/Skript)
#   Keine Addons nötig.
#
#   INSTALLATION:
#   1. Datei nach /plugins/Skript/scripts/softrestart.sk kopieren
#   2. /sk reload softrestart
#
#   BEFEHLE:
#   /softrestart [<Minuten>]   -> startet Countdown (Standard: 2 Minuten)
#   /cancelrestart             -> bricht laufenden Countdown ab
#
#   WICHTIG - "restart" vs "stop":
#   Der Effekt "execute console command "restart"" funktioniert nur,
#   wenn dein Server über ein Start-Skript/einen Panel-Wrapper läuft,
#   der den Prozess nach Beenden automatisch neu startet (z.B. Pterodactyl,
#   die meisten Hosting-Panels, oder ein eigenes .bat/.sh mit Schleife).
#   Falls das bei dir NICHT der Fall ist, ersetze ganz unten
#   "restart" durch "stop" - dann fährt der Server einfach herunter.
# =====================================================================

options:
    prefix: &8[&6Server&8]&r

# ------------------------- /softrestart Befehl -------------------------

command /softrestart [<number>]:
    aliases: /restartserver
    usage: &c/softrestart [Minuten]
    permission: server.restart
    permission message: {@prefix} &cDu darfst diesen Befehl nicht nutzen.
    trigger:
        if {restart::active} is true:
            send "{@prefix} &cEs läuft bereits ein Neustart-Timer! Nutze /cancelrestart zum Abbrechen." to player
            stop trigger
        if arg-1 is set:
            set {restart::seconds} to (arg-1 * 60)
        else:
            set {restart::seconds} to 120
        set {restart::active} to true
        set {_minutes} to {restart::seconds} / 60
        broadcast "{@prefix} &eServer-Neustart in &c%{_minutes}% Minute(n)&e!"
        play sound "entity.experience_orb.pickup" with volume 1 with pitch 1 to all players

# ------------------------- /cancelrestart Befehl -------------------------

command /cancelrestart:
    aliases: /restartcancel
    permission: server.restart
    permission message: {@prefix} &cDu darfst diesen Befehl nicht nutzen.
    trigger:
        if {restart::active} is true:
            set {restart::active} to false
            delete {restart::seconds}
            broadcast "{@prefix} &aDer geplante Server-Neustart wurde abgebrochen."
        else:
            send "{@prefix} &cEs läuft aktuell kein Neustart-Timer." to player

# ------------------------- Countdown-Logik -------------------------

every second:
    if {restart::active} is true:
        if {restart::seconds} is greater than 0:
            if {restart::seconds} is 60, 30, 10, 5, 4, 3, 2 or 1:
                broadcast "{@prefix} &eServer-Neustart in &c%{restart::seconds}% Sekunde(n)&e!"
                play sound "ui.button.click" with volume 1 with pitch 1 to all players
            if {restart::seconds} is less than or equal to 5:
                send title "&c&l%{restart::seconds}%" with subtitle "&7Sekunden bis zum Neustart" to all players for 1 second
            remove 1 from {restart::seconds}
        else:
            set {restart::active} to false
            broadcast "{@prefix} &c&lDer Server startet jetzt neu!"
            execute console command "save-all"
            wait 3 seconds
            loop all players:
                kick loop-player because of "&8[&6Server&8]&r &eServer-Neustart&r%nl%&7Bitte verbinde dich in ein paar Sekunden erneut."
            wait 2 seconds
            execute console command "restart"
